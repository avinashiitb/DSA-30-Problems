          {
            "id": "c5236cb5-3d66-4941-9589-1c8615428eb9",
            "type": "codeBlock",
            "props": {
              "language": "javascript",
              "code": "temperatures = [73,74,75,71,69,72,76,73]\n\nStack = []\n\n73\n\nStack = [0]\n\n----------------\n\n74 > 73\n\nanswer[0] = 1\n\nStack = [1]\n\n----------------\n\n75 > 74\n\nanswer[1] = 1\n\nStack = [2]\n\n----------------\n\n71\n\nStack = [2,3]\n\n----------------\n\n69\n\nStack = [2,3,4]\n\n----------------\n\n72 > 69\n\nanswer[4] = 1\n\n72 > 71\n\nanswer[3] = 2\n\nStack = [2,5]\n\n----------------\n\n76 > 72\n\nanswer[5] = 1\n\n76 > 75\n\nanswer[2] = 4\n\nStack = [6]\n\n----------------\n\n73\n\nStack = [6,7]\n\nRemaining indices have no warmer day.\n\nFinal Answer\n\n[1,1,4,2,1,1,0,0]",
              "wordWrap": "true"
            },
            "children": []
