            "type": "numberedListItem",
            "props": {
              "backgroundColor": "default",
              "textColor": "default",
              "textAlignment": "left"
            },
            "content": [
              {
                "type": "text",
                "text": "Traverse the temperature array from left to right.",
                "styles": {}
              }
            ],
