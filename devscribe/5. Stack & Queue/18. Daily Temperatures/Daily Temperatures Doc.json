                  "backgroundColor": "default",
                  "textColor": "default",
                  "textAlignment": "left"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Calculate the number of days waited.",
                    "styles": {}
                  }
                ],
                "children": []
              }
            ]
          },
          {
            "id": "717353a6-9b62-4516-baeb-38cb6b1349c9",
