              "backgroundColor": "default",
              "textColor": "default",
              "textAlignment": "left"
            },
            "content": [
              {
                "type": "text",
                "text": "The length of a path between two nodes is represented by the ",
                "styles": {}
              },
              {
                "type": "text",
                "text": "number of edges",
                "styles": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " between them.",
                "styles": {}
