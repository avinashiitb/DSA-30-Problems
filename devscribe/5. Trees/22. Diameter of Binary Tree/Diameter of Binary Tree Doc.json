            "content": [
              {
                "type": "text",
                "text": "The diameter of a binary tree is the length of the ",
                "styles": {}
              },
              {
                "type": "text",
                "text": "longest path between any two nodes",
                "styles": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " in the tree. This path may or may not pass through the root.",
                "styles": {}
              }
