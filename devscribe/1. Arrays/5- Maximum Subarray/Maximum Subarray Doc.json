          {
            "id": "e1838a5e-b92b-4256-8d92-e21e6af037b3",
            "type": "paragraph",
            "props": {
              "backgroundColor": "default",
              "textColor": "default",
              "textAlignment": "left"
            },
            "content": [
              {
                "type": "text",
                "text": "Kadane's Algorithm is one of the most frequently asked dynamic programming problems. The key insight is that if the running sum becomes smaller than the current element, it is better to start a new subarray rather than continue the existing one.",
                "styles": {}
              }
            ],
            "children": []
          },
          {
            "id": "02db2acd-2d90-4970-974e-6857ede03bc2",
            "type": "paragraph",
            "props": {
              "backgroundColor": "default",
              "textColor": "default",
              "textAlignment": "left"
            },
            "content": [
