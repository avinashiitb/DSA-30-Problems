      "type": "code-editor",
      "data": {
        "code": "class Solution {\n\n    public solve(A: number[]): number {\n\n        let Min = Infinity;\n        let Max = A[0];\n\n        let Profit = 0;\n\n        if (A.length === 0) {\n            return 0;\n        }\n\n        for (let i = 0; i < A.length; i++) {\n\n            if (A[i] < Min) {\n                Min = A[i];\n                Max = A[i];\n            } else if (Max < A[i]) {\n                Max = A[i];\n            }\n\n            Profit = Math.max(Profit, Max - Min);\n        }\n\n        return Profit;\n    }\n\n    // Test the code\n    public static main(): void {\n\n        // This is custom code to read Test case in DevScribe\n        const prices = Input.getIntArray(\"prices\");\n        const output = Input.getInt(\"output\");\n\n        console.log(\"Expected: \" + output);\n\n        const sol = new Solution();\n\n        const Profit = sol.solve(prices);\n\n        console.log(\"Profit: \" + Profit);\n    }\n}\n\nSolution.main();",
        "language": "typescript",
        "output": "Expected: 5\nProfit: 5",
