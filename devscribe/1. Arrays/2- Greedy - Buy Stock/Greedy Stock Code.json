      "type": "code-editor",
      "data": {
        "code": "class Solution {\n    public int solve(int[] A) {\n        int Min = Integer.MAX_VALUE;\n        int Max = A[0];\n\n        int Profit = 0;\n        if(A.length == 0) return 0;\n      \n        for(int i = 0; i< A.length; i++) {\n          if(A[i] < Min) {\n            Min = A[i];\n            Max = A[i];\n          } else if(Max < A[i]) {\n            Max = A[i];\n          }\n          Profit = Math.max(Profit, Max - Min);\n        }\n\n        return Profit;\n    }\n\n    // Test the code\n    public static void main(String[] args) {\n        // This is custom code to read Test case in Devscribe\n        int[] nums = Input.getIntArray(\"prices\"); \n        int output = Input.getInt(\"output\");\n        System.out.println(\"Expected: \"+ output);\n      \n        Solution sol = new Solution();\n\n        int Profit = sol.solve(nums);\n\n        System.out.println(\"Profit: \" + Profit);\n    }\n}",
        "language": "java",
        "output": "Expected: 5\nProfit: 5\n",
