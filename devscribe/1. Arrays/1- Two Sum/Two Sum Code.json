        "code": "import java.util.*;\n\nclass Solution {\n    public void solve(int[] A, int target) {\n        HashMap<Integer, Integer> Map = new HashMap<>();\n\n        for(int i = 0; i< A.length; i++) {\n          int X = target - A[i];\n          if(Map.containsKey(X)) {\n            int j = Map.get(X);\n            System.out.println(\"Pair: [\" + j + \", \" + i + \"]\");\n          }\n          Map.put(A[i], i);\n        }\n        \n    }\n\n    // Test the code\n    public static void main(String[] args) {\n        // This is custom code to read Test case in Devscribe\n        int[] nums = Input.getIntArray(\"nums\"); \n        int target = Input.getInt(\"target\");\n        int[] output = Input.getIntArray(\"output\");\n      \n        System.out.println(\"Expected: \"+ Arrays.toString(output));\n      \n        Solution sol = new Solution();\n\n        sol.solve(nums, target);\n    }\n}",
