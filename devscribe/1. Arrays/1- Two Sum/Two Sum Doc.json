            ],
            "children": []
          },
          {
            "id": "0605c00e-79d6-4267-ba5b-5ff1a6ea7431",
            "type": "paragraph",
            "props": {
              "backgroundColor": "default",
              "textColor": "default",
              "textAlignment": "left"
            },
            "content": [
              {
                "type": "text",
                "text": "Whenever you're asked to find a pair of elements that satisfy a condition, consider using a ",
                "styles": {}
              },
              {
                "type": "text",
                "text": "HashMap",
                "styles": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": ". It often reduces the time complexity from ",
                "styles": {}
              },
              {
                "type": "text",
                "text": "O(n²)",
                "styles": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " to ",
                "styles": {}
              },
              {
                "type": "text",
                "text": "O(n)",
                "styles": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " by enabling constant-time lookups.",
                "styles": {}
              }
            ],
            "children": []
          }
