        "code": "import java.util.*;\n\nclass Solution {\n    public void solve(int[] A) {\n        int[] Ans = new int[A.length];\n        Arrays.fill(Ans, 1);\n\n        // Preifx Skip\n        int prefix = 1;\n        for(int i = 0; i< A.length; i++) {\n          Ans[i] *= prefix;\n          prefix *= A[i];\n        }\n\n        // Suffix Skip\n        int suffix = 1;\n        for( int i= A.length - 1; i >= 0; i--) {\n          Ans[i] *= suffix;\n          suffix *= A[i];\n        }\n\n        // Printing Array\n        System.out.print(Arrays.toString(Ans));\n    }\n\n    // Test the code\n    public static void main(String[] args) {\n        // This is custom code to read Test case in Devscribe\n        int[] nums = Input.getIntArray(\"nums\"); \n        int[] output = Input.getIntArray(\"output\");\n      \n        System.out.println(\"Expected: \"+ Arrays.toString(output));\n      \n        Solution sol = new Solution();\n\n        sol.solve(nums);\n    }\n}",
